# Copy to server/.env for local development. Never commit .env.
PORT=8080
NODE_ENV=development

# Local emulators. Remove these on Cloud Run, which uses its service account.
GOOGLE_CLOUD_PROJECT=demo-humandesign
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public site URL, used for the cancel link in confirmation emails
WEB_BASE_URL=http://localhost:5173

# Reverse proxies in front of the service. Used to read the real client IP.
TRUST_PROXY_HOPS=1

# Gmail sender. Required when NODE_ENV=production; otherwise emails are only logged.
GMAIL_USER=
GMAIL_APP_PASSWORD=
