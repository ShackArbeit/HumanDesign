# Copy to Server/.env and fill in real values. Never commit .env.
PORT=8000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NO_AUTH_SESSION_SECRET=

# Gmail sender and Google App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
